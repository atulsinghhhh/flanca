// ───────────────────────────── inventory, assets, gate ─────────────────────────────

model InventoryItem {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @db.Uuid
  name      String
  group     String? // STATIONERY | UNIFORM | LAB | SPORTS | HOUSEKEEPING
