  @@index([schoolId, date])
}

model Asset {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @db.Uuid
  name            String
  tag             String?
  location        String?
  supplier        String?
  purchaseDate    DateTime? @db.Date
  cost            Int?
  amcVendor       String?
  amcExpiry       DateTime? @db.Date
  insuranceExpiry DateTime? @db.Date
