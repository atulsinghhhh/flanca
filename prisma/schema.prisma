  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Visitor {
  id         String    @id @default(uuid()) @db.Uuid
  schoolId   String    @db.Uuid
  name       String
  phone      String?
  purpose    String?
  whomToMeet String?
  idProof    String?
  inAt       DateTime  @default(now())
  outAt      DateTime?
  passNo     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, inAt])
}

// Early pickup / gate release — the safety record a school actually gets asked for.
model GatePass {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @db.Uuid
  studentId  String?  @db.Uuid
  passNo     String
  reason     String
  releasedTo String
  relation   String?
  approvedBy String?  @db.Uuid
  issuedAt   DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, issuedAt])
}

// ───────────────────────────── migration: preview, approve, undo ─────────────────────────────

// The #1 reason schools don't switch is fear of data loss. So an import is a reviewable
// object: upload → validate every row → the principal SEES it → apply → and it can be undone.
model ImportBatch {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @db.Uuid
  kind              ImportKind
  status            ImportStatus @default(UPLOADED)
  fileName          String
  totalRows         Int          @default(0)
  okRows            Int          @default(0)
  warningRows       Int          @default(0)
  errorRows         Int          @default(0)
  appliedRows       Int          @default(0)
  columnMap         Json? // detected source column → Flanca field
  uploadedBy        String?      @db.Uuid
  uploadedAt        DateTime     @default(now())
  appliedAt         DateTime?
  revertedAt        DateTime?
  note              String?
  /**
   * Classes and sections this batch had to CREATE to place its children.
   * Recorded because undo has to leave the school exactly as it found it, and
   * that is the whole promise the import is sold on. Without this, undoing an
   * import of 847 children left behind the eleven classes and thirty sections
   * it invented on the way in — empty, but visible in every dropdown, and the
   * clerk can see we did not really put it back.
   * Ids rather than names, so a class the school already had is never at risk.
   */
  createdClassIds   String[]     @default([]) @db.Uuid
  createdSectionIds String[]     @default([]) @db.Uuid

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [uploadedBy], references: [id])
  rows   ImportRow[]

  @@index([schoolId, status])
}

model ImportRow {
  id            String         @id @default(uuid()) @db.Uuid
  batchId       String         @db.Uuid
  rowNumber     Int
  raw           Json
  parsed        Json?
  state         ImportRowState @default(OK)
  messages      Json? // [{field, level, message}]
  createdEntity String? // "Student"
  createdId     String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, state])
}

// Report builder: the principal saves the query they run every month.
model SavedReport {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @db.Uuid
  userId    String?  @db.Uuid
  name      String
  kind      String // FEE_DUES | ATTENDANCE | RESULTS | ADMISSIONS | STAFF
  config    Json
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId])
}
